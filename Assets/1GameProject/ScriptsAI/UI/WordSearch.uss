.ws-root {
    flex-grow: 1;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-color: rgb(16, 20, 30);
    color: rgb(236, 240, 248);
}

.ws-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.ws-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(249, 252, 255);
}

.ws-status {
    font-size: 16px;
    color: rgb(168, 214, 189);
}

.ws-body {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 16px;
}

.ws-grid-panel {
    flex-grow: 1;
    min-width: 280px;
    background-color: rgb(25, 32, 45);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding: 12px;
}

.ws-side-panel {
    width: 280px;
    min-width: 220px;
    background-color: rgb(24, 30, 41);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding: 12px;
    gap: 10px;
}

.ws-section-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: rgb(230, 236, 246);
}

.ws-grid {
    align-self: center;
    gap: 2px;
}

.word-cell {
    width: 36px;
    height: 36px;
    margin-right: 2px;
    margin-bottom: 2px;
    unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 18px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgb(44, 54, 70);
    color: rgb(242, 246, 255);
}

.word-cell-selected {
    background-color: rgb(74, 131, 255);
    color: rgb(255, 255, 255);
}

.word-cell-found {
    background-color: rgb(42, 156, 103);
    color: rgb(255, 255, 255);
}

.ws-words-scroll {
    flex-grow: 1;
    max-height: 300px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgb(37, 45, 59);
    padding: 6px;
}

.ws-words-list {
    gap: 4px;
}

.word-item {
    font-size: 16px;
    color: rgb(228, 232, 242);
}

.word-found {
    color: rgb(126, 231, 164);
    -unity-font-style: bold;
}

.ws-info {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.ws-info-label {
    font-size: 15px;
    color: rgb(186, 198, 214);
}

.ws-selected-word {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 218, 117);
}

.ws-progress {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(148, 203, 255);
}

.ws-restart-btn {
    height: 38px;
    margin-top: 6px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgb(68, 104, 190);
    color: rgb(249, 251, 255);
    -unity-font-style: bold;
}

.ws-restart-btn:hover {
    background-color: rgb(82, 123, 222);
}
