<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="WordSearch.uss" />

    <ui:VisualElement name="Root" class="ws-root">
        <ui:VisualElement class="ws-header">
            <ui:Label text="Филворды" class="ws-title" />
            <ui:Label name="Status" text="Find all words" class="ws-status" />
        </ui:VisualElement>

        <ui:VisualElement class="ws-body">
            <ui:VisualElement class="ws-grid-panel">
                <ui:Label text="Сетка" class="ws-section-title" />
                <ui:VisualElement name="Grid" class="ws-grid" />
            </ui:VisualElement>

            <ui:VisualElement class="ws-side-panel">
                <ui:Label text="Слова" class="ws-section-title" />
                <ui:ScrollView name="WordsScroll" class="ws-words-scroll" mode="Vertical">
                    <ui:VisualElement name="WordsList" class="ws-words-list" />
                </ui:ScrollView>

                <ui:VisualElement class="ws-info">
                    <ui:Label text="Выбор:" class="ws-info-label" />
                    <ui:Label name="SelectedWord" text="" class="ws-selected-word" />
                </ui:VisualElement>

                <ui:VisualElement class="ws-info">
                    <ui:Label text="Прогресс:" class="ws-info-label" />
                    <ui:Label name="Progress" text="0/0" class="ws-progress" />
                </ui:VisualElement>

                <ui:Button name="RestartButton" text="Новая игра" class="ws-restart-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
