:root {
}

.MenuButton {
    width: auto;
    height: auto;
    background-image: url("project://database/Assets/1GameProject/Art/UI/Button%201.png?fileID=2800000&guid=7d225d5e047f70544a28684b330a9100&type=3#Button 1");
    background-size: 100% 100%;
    aspect-ratio: auto;
    min-width: 360px;
    position: relative;
    min-height: 16px;
    align-items: auto;
    align-content: auto;
    justify-content: center;
    display: flex;
    visibility: visible;
    overflow: visible;
    margin-top: 24px;
    margin-right: 24px;
    margin-bottom: 24px;
    margin-left: 24px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    border-bottom-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-left-width: 0;
    border-right-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
}

.Text {
    background-image: url("project://database/Assets/1GameProject/Art/UI/Button%201.png?fileID=2800000&guid=7d225d5e047f70544a28684b330a9100&type=3#Button 1");
    position: relative;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(188, 188, 188, 0);
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 218, 160);
    text-overflow: clip;
    -unity-text-outline-width: 1px;
    white-space: nowrap;
    -unity-text-generator: standard;
    -unity-text-auto-size: none;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}
