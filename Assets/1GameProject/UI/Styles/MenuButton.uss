:root {
}

.MenuButton {
    width: 120%;
    height: 16%;
    background-image: url("project://database/Assets/1GameProject/Art/UI/Button%201.png?fileID=2800000&guid=7d225d5e047f70544a28684b330a9100&type=3#Button 1");
    background-size: 100% 100%;
    aspect-ratio: auto;
}

.Text {
    background-image: url("project://database/Assets/1GameProject/Art/UI/Button%201.png?fileID=2800000&guid=7d225d5e047f70544a28684b330a9100&type=3#Button 1");
    position: relative;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(188, 188, 188, 0);
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 218, 160);
    text-overflow: clip;
    -unity-text-outline-width: 1px;
    white-space: nowrap;
    -unity-text-generator: standard;
    -unity-text-auto-size: none;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}




